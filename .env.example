# ========================================================
# AudioKing Production Environment Variables (.env.example)
# Copy this file to .env on your server or enter these keys in
# your hosting dashboard (Render / Railway / Heroku).
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Database (Default points to SQLite data directory inside project)
DATABASE_PATH=./server/data/audioking.db

# Authentication Session Secret (Generate a strong random string)
SESSION_SECRET=your_strong_random_session_secret_change_me_in_production
SESSION_EXPIRY_MS=2592000000

# Initial Administrator Account (Seeded on first run if no admin exists)
ADMIN_NAME="AudioKing Administrator"
ADMIN_EMAIL=admin@audioking.in
ADMIN_PASSWORD=SetYourStrongAdminPasswordHere!

# CORS / Allowed Frontend Origins (Comma-separated)
ALLOWED_ORIGIN=https://audioking30.github.io,http://localhost:3000

# Transactional Email (Gmail SMTP for OTP & Customer Order Confirmations)
GMAIL_USER=audioking30@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password_here
EMAIL_FROM="AudioKing <audioking30@gmail.com>"
EMAIL_FROM_NAME="AudioKing"

# Google OAuth 2.0 (From Google Cloud Console: APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://audioking-api.onrender.com/api/auth/google/callback

# Cashfree Payment Gateway (From Cashfree Merchant Dashboard > Developers > API Keys)
# Mode: 'sandbox' for test / staging, 'production' for live payments
CASHFREE_APP_ID=TEST10000000_your_cashfree_app_id
CASHFREE_SECRET_KEY=TEST_your_cashfree_secret_key_here
CASHFREE_MODE=sandbox
CASHFREE_API_VERSION=2023-08-01
